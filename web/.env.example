# Copy to .env.local for development.
# Cloud: values from Supabase project -> Settings -> API.
# Self-hosted: http://<server>:8000 and the ANON_KEY from docker/.env
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
# Only for GitHub Pages project sites, e.g. /maintenance-tracking-system
NEXT_PUBLIC_BASE_PATH=
